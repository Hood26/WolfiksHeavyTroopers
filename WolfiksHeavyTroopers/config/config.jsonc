    "Cultist_Mask": {
      "enable": true,
      "sold_by_trader": true,
      "trader": "skier",
      "trader_currency_type": "roubles",
      "quest_required": false, // Skier "Night Sweep" Quest
      "flea_banned": true,
      "trader_price": 450000,
      "flea_price": 666666,
      "handbook_price": 550000,
      "trader_stock": 2,
      "loyalty_level": 4,
