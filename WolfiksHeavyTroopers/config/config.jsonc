{
  // Mod Configurations For WolfiksHeavyTroopers
  // ======================================
  // Any values you change will be set on SPT server restart.
  "Items": {
    "Coyote_Mask": {
      // Enables or disables the mask in-game.
      // IMPORTANT: If you disable a mask you MUST delete all occurances of the mask in your inventory and on your PMC or the server will throw errors about your profile being invalid
      "enable": true,
      // Toggles whether the mask will be sold by Peacekeeper in-game
      "sold_by_trader": true,
      // Trader that sells the mask and used to determine trader questline if a quest is required for the mask
      // Available trader options (must be all lowercased exactly as follows): "peacekeeper", "prapor", "skier", "mechanic", "jaeger", "ragman", "therapist"
      "trader": "peacekeeper",
      // Determines the currency the trader will sell the mask for. Options include: "dollars", "roubles", and "euros"
      "trader_currency_type": "dollars",
      // Toggles whether mask is locked behind quest reward
      "quest_required": false,
      // Determines which quest the mask will be unlocked at. Can be left empty if quest_required is false.
      // If you would like to change the quest you can find the quest ids at: SPT/SPT_Data/database/templates/quests.json
      "quest_id": "",
      // toggles whether the mask will be able to be bought and sold on the flea-market
      "flea_banned": false,
      // Price of the mask in Dollars sold by Peacekeeper
      "trader_price": 1000,
      // Price in Roubles for the average selling price on the flea-market
      "flea_price": 180000,
      // The Quick Sell price of the mask when sold to a trader (Kinda)
      "handbook_price": 140000,
      // How many masks that can be bought from trader during refresh period
      "trader_stock": 2,
      // Loyalty level the mask will be sold from Peacekeeper
      "loyalty_level": 3,
      // Masks armour level is defined here
      "armor_class_level": 3,
      // Durability that the mask will be sold at from Peacekeeper
      "durability": 45,
      // Maximum durabilty the mask can hold
      "max_durability": 45,
      // static_loot_container_probabilities Information:
      //   - container_name: number (heavy trooper mask loot weight per container)
      //
      //   What this means:
      //      - Weights are relative. Item chance inside a container = heavy trooper mask weight / sum(all other item weights in that container).
      //      - Weights only affect selection inside that container's static loot pool; they do NOT change how often the container spawns.
      //      - 0 means excluded. Increasing one weight reduces others' share. Use smaller weights for rarer items.
      //
      //   These preset numbers I've chosen are pretty low so the masks will be rare to find in-game.

      "static_loot_container_probabilities": {
        "weapon_box_5x5": 30,   // Weapon Box 1
        "weapon_box_4x4": 60,   // Weapon Box 2
        "weapon_box_6x3": 60,   // Weapon Box 3 (6 width x 3 height loot grid)
        "weapon_box_5x2": 60,   // Weapon Box 4
        "ground_cache_4x4": 40, // Ground Cache
        "wooden_crate_5x2": 40, // Wooden Crate
        "duffle_bag_4x3": 60,   // Duffle Bag
        "dead_scav_4x4": 60     // Dead Scav
      }
    },
    "Tan_Mask": {
      "enable": true,
      "sold_by_trader": true,
      "trader": "peacekeeper",
      "trader_currency_type": "dollars",
      "quest_required": false,
      "flea_banned": false,
      "trader_price": 1800,
      "flea_price": 320000,
      "handbook_price": 250000,
      "trader_stock": 2,
      "loyalty_level": 4,
      "armor_class_level": 4,
      "durability": 50,
      "max_durability": 50,
      "static_loot_container_probabilities": {
        "weapon_box_5x5": 20,
        "weapon_box_4x4": 35,
        "weapon_box_6x3": 35,
        "weapon_box_5x2": 35,
        "ground_cache_4x4": 25,
        "wooden_crate_5x2": 25,
        "duffle_bag_4x3": 35,
        "dead_scav_4x4": 35
      }
    },
