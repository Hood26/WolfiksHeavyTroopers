      "flea_banned": false,
      "trader_price": 2000,
      "flea_price": 350000,
      "handbook_price": 280000,
      "trader_stock": 2,
      "loyalty_level": 4,
      "armor_class_level": 4,
      "durability": 50,
      "max_durability": 50,
      "static_loot_container_probabilities": {
        "weapon_box_5x5": 20,
        "weapon_box_4x4": 35,
        "weapon_box_6x3": 35,
        "weapon_box_5x2": 35,
        "ground_cache_4x4": 25,
        "wooden_crate_5x2": 25,
        "duffle_bag_4x3": 35,
        "dead_scav_4x4": 35
      }
    },
    "Wolf_Mask": {
      "enable": true,
      "sold_by_trader": true,
      "trader": "peacekeeper",
      "trader_currency_type": "dollars",
      "quest_required": false, // Peacekeeper "The Guide" Quest
      "flea_banned": true,
      "trader_price": 3000,
      "flea_price": 500000,
      "handbook_price": 400000,
      "trader_stock": 2,
      "loyalty_level": 4,
      "armor_class_level": 5,
      "durability": 60,
      "max_durability": 60,
      "static_loot_container_probabilities": {
        "weapon_box_5x5": 10,
        "weapon_box_4x4": 25,
        "weapon_box_6x3": 25,
        "weapon_box_5x2": 25,
        "ground_cache_4x4": 15,
        "wooden_crate_5x2": 15,
        "duffle_bag_4x3": 20,
